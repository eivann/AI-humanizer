# Secure Server Configuration — Copy this to .env and fill in your values
# NEVER commit your actual .env file to GitHub!

# Your FreeModel AI API Key (get one at https://freemodel.dev)
FREEMODEL_API_KEY=your_api_key_here

# OpenAI / GPT Configuration
OPENAI_BASE_URL=https://api.freemodel.dev/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude Configuration (optional)
ANTHROPIC_BASE_URL=https://cc.freemodel.dev/v1
ANTHROPIC_MODEL=claude-t0

# Server
PORT=3001

# Rate limiting (requests per minute per IP)
RATE_LIMIT_MAX=15
